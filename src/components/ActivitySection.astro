---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const { activity, nav } = tr;
---

<section class="relative pb-10 md:pb-16 pt-4 md:pt-8" id="activity">
  <div class="section-container">
    
    <h1 class="text-h2 text-foreground mb-12 md:mb-16 flex flex-col items-start gap-3">
      <span class="flex items-center gap-3">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-primary shadow-[0_0_12px_rgba(249,115,22,0.5)]"></span>
        {nav.activity}
      </span>
      <span class="block h-0.5 w-16 rounded-full bg-gradient-to-r from-primary to-primary/0"></span>
    </h1>
    <p class="text-body-lg text-muted max-w-3xl mb-8">{locale === 'ru'
      ? 'Обучение и профессиональная активность Магомедова Магомеда Расуловича: прогресс Google Project Management, сертификаты по управлению проектами и MySQL, GitHub и резюме.'
      : 'Learning and professional activity of Magomed Rasulovich Magomedov: Google Project Management progress, project management and MySQL certificates, GitHub contributions and resume.'}</p>

    <!-- GitHub Activity -->
    <div class="mb-12 md:mb-16">
      <div class="flex flex-col gap-6">
        
        <!-- Graph Card -->
        <div class="liquid-glass-card p-6 md:p-8 flex flex-col h-full w-full relative">
          <!-- Last Updated Label -->
          <span class="absolute top-3 right-4 text-[11px] text-muted/40 font-mono select-none" id="gh-last-updated"></span>
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
            <div class="flex items-start gap-4">
              <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">📊</span>
              <div>
                <h3 class="text-badge text-primary mb-3">{activity.githubStats}</h3>
                <p class="text-lg font-display font-semibold text-foreground mb-2">{activity.githubGraphTitle}</p>
                <p class="text-sm text-muted leading-relaxed">{activity.githubGraphDesc}</p>
              </div>
            </div>
            <div class="flex gap-2 gh-years shrink-0">
              <button class="gh-year-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-primary text-white transition-colors shadow-[0_0_15px_rgba(249,115,22,0.3)]" data-year="2026">2026</button>
              <button class="gh-year-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-overlay text-foreground border border-edge hover:border-primary/50 transition-colors" data-year="2025">2025</button>
              <button class="gh-year-btn px-3 py-1.5 rounded-xl text-xs font-medium bg-overlay text-foreground border border-edge hover:border-primary/50 transition-colors" data-year="2024">2024</button>
            </div>
          </div>
          
          <div class="mt-4 flex-1 min-h-[180px] flex items-center justify-center overflow-x-auto relative z-10" id="gh-target">
            <p class="text-muted flex items-center gap-3">
              <span class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
              {activity.loadingGit}
            </p>
          </div>
        </div>
        <div class="liquid-glass-card p-6 md:p-8 h-full w-full expandable-activity-card" id="github-radar-card">
          <button type="button" class="expandable-activity-trigger w-full flex items-start justify-between gap-4 text-left relative z-10" aria-expanded="false" aria-controls="github-radar-panel">
            <span class="flex items-start gap-4">
              <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">🕸️</span>
              <span>
                <span class="text-badge text-primary mb-3 block">{activity.githubStats}</span>
                <span class="text-lg font-display font-semibold text-foreground mb-2 block">{activity.radarTitle}</span>
                <span class="text-sm text-muted leading-relaxed block">{activity.radarDesc}</span>
              </span>
            </span>
            <svg class="expandable-activity-chevron w-5 h-5 shrink-0 mt-1 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="expandable-activity-panel" id="github-radar-panel">
            <div class="expandable-activity-panel-inner">
              <div class="mt-6 min-h-[280px] flex items-center justify-center relative z-10" id="radar-target">
                <canvas id="radar-canvas" width="400" height="400" class="max-w-full h-auto"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- Streak Card -->
        <div class="liquid-glass-card p-6 md:p-8 flex flex-col h-full w-full">
          <div class="flex items-start gap-4 mb-4">
            <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">🔥</span>
            <div>
              <h3 class="text-badge text-primary mb-3">{activity.githubStats}</h3>
              <p class="text-lg font-display font-semibold text-foreground mb-2">{activity.githubStreakTitle}</p>
              <p class="text-sm text-muted leading-relaxed">{activity.githubStreakDesc}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                <span class="px-2.5 py-1 rounded-lg bg-primary/10 border border-primary/20 text-xs text-foreground/70 font-medium">GitHub</span>
                <span class="px-2.5 py-1 rounded-lg bg-primary/10 border border-primary/20 text-xs text-foreground/70 font-medium">Activity</span>
              </div>
            </div>
          </div>
          
          <div class="mt-4 flex-1 flex items-center justify-center overflow-x-auto overflow-y-hidden relative z-10">
            <!-- Light Mode -->
            <img 
              src="https://streak-stats.demolab.com/?user=Johan0565&theme=transparent&hide_border=true&ring=f97316&fire=f97316&currStreakLabel=f97316&sideNums=0f172a&currStreakNum=0f172a&sideLabels=64748b&dates=64748b"
              alt="GitHub Streaks" 
              class="max-w-full h-auto scale-[1.15] transform origin-center gh-streak-light"
              referrerpolicy="no-referrer"
            >
            <!-- Dark Mode -->
            <img 
              src="https://streak-stats.demolab.com/?user=Johan0565&theme=transparent&hide_border=true&ring=f97316&fire=f97316&currStreakLabel=f97316&sideNums=ffffff&currStreakNum=ffffff&sideLabels=94a3b8&dates=94a3b8"
              alt="GitHub Streaks Dark" 
              class="max-w-full h-auto scale-[1.15] transform origin-center gh-streak-dark"
              referrerpolicy="no-referrer"
            >
          </div>
        </div>

        

        <!-- Stepik Combined Card -->
        <div class="liquid-glass-card p-6 md:p-8 flex flex-col lg:flex-row gap-6 h-full w-full relative">
          <!-- Last Updated Label -->
          <span class="absolute top-3 right-4 text-[11px] text-muted/40 font-mono select-none" id="stepik-last-updated"></span>
          <!-- Left: Heatmap -->
          <div class="flex-1 flex flex-col min-w-0">
            <div class="flex items-start gap-4 mb-4">
              <span class="text-2xl shrink-0 mt-0.5" aria-hidden="true">📈</span>
              <div>
                <h3 class="text-badge text-primary mb-3">Stepik</h3>
                <p class="text-lg font-display font-semibold text-foreground mb-2">{activity.stepikGraphTitle}</p>
                <p class="text-sm text-muted leading-relaxed">{activity.stepikGraphDesc}</p>
              </div>
            </div>
            
            <div class="mt-4 flex-1 min-h-[180px] flex items-center justify-start overflow-x-auto relative z-10" id="stepik-target">
              <p class="text-muted flex items-center gap-3" id="stepik-loading">
                <span class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
                {activity.loadingStepik}
              </p>
            </div>
          </div>

          <!-- Right: Stats -->
          <div class="lg:w-64 shrink-0 flex flex-col justify-center gap-6 border-t lg:border-t-0 lg:border-l border-edge pt-6 lg:pt-0 lg:pl-8">
            <div class="flex flex-col gap-2 group">
              <div class="text-4xl font-display font-bold text-foreground tabular-nums tracking-tight group-hover:text-primary transition-colors duration-300" id="stepik-knowledge">
                --
              </div>
              <div class="text-sm font-medium text-muted uppercase tracking-wider">{activity.stepikKnowledge}</div>
            </div>
            
            <div class="flex flex-col gap-2 group">
              <div class="text-4xl font-display font-bold text-foreground tabular-nums tracking-tight group-hover:text-primary transition-colors duration-300" id="stepik-streak">
                --
              </div>
              <div class="text-sm font-medium text-muted uppercase tracking-wider">{locale === 'ru' ? 'Текущий Стрик' : 'Current Streak'}</div>
            </div>
          </div>
        </div>

        <!-- Duolingo Activity Card -->
        <div class="liquid-glass-card p-6 md:p-8 h-full w-full relative expandable-activity-card" id="duolingo-activity-card">
          <span class="absolute top-3 right-4 text-[11px] text-muted/40 font-mono select-none" id="duolingo-last-updated"></span>
          <button type="button" class="expandable-activity-trigger w-full flex items-start justify-between gap-4 text-left pr-2 relative z-10" aria-expanded="false" aria-controls="duolingo-activity-panel">
            <span class="flex items-start gap-4">
              <img src="/images/duolingoIcon.png" alt="" class="duolingo-mark shrink-0 mt-0.5" width="40" height="40" loading="lazy" decoding="async" aria-hidden="true">
              <span>
                <span class="text-badge text-primary mb-3 block">Duolingo</span>
                <span class="text-lg font-display font-semibold text-foreground mb-2 block">{activity.duolingoTitle}</span>
                <span class="text-sm text-muted leading-relaxed block">{activity.duolingoDesc}</span>
              </span>
            </span>
            <svg class="expandable-activity-chevron w-5 h-5 shrink-0 mt-1 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          <div class="expandable-activity-panel" id="duolingo-activity-panel">
            <div class="expandable-activity-panel-inner">
              <div class="pt-6 flex flex-col gap-5 max-w-sm relative z-10">
                <p class="hidden text-sm text-red-400/90" id="duolingo-status"></p>
                <div class="flex flex-col gap-1.5 group">
                  <div class="flex items-center gap-3 text-3xl md:text-4xl font-display font-bold text-foreground tabular-nums tracking-tight group-hover:text-[#58cc02] transition-colors duration-300">
                    <span class="duolingo-stat-icon" aria-hidden="true">
                      <img src="/images/usaIcon.png" alt="" class="duolingo-stat-icon-image" width="48" height="34" loading="lazy" decoding="async">
                    </span>
                    <span id="duolingo-level">--</span>
                  </div>
                  <div class="text-xs sm:text-sm font-medium text-muted uppercase tracking-wider">{activity.duolingoXpLevel}</div>
                </div>
                <div class="flex flex-col gap-1.5 group">
                  <div class="flex items-center gap-3 text-3xl md:text-4xl font-display font-bold text-foreground tabular-nums tracking-tight group-hover:text-[#58cc02] transition-colors duration-300">
                    <span class="duolingo-stat-icon" aria-hidden="true">⚡</span>
                    <span id="duolingo-xp">--</span>
                  </div>
                  <div class="text-xs sm:text-sm font-medium text-muted uppercase tracking-wider">{activity.duolingoCourseXp}</div>
                </div>
                <div class="flex flex-col gap-1.5 group">
                  <div class="flex items-center gap-3 text-3xl md:text-4xl font-display font-bold text-foreground tabular-nums tracking-tight group-hover:text-[#58cc02] transition-colors duration-300">
                    <span class="duolingo-stat-icon" aria-hidden="true">🔥</span>
                    <span id="duolingo-streak">--</span>
                  </div>
                  <div class="text-xs sm:text-sm font-medium text-muted uppercase tracking-wider">{activity.duolingoStreak}</div>
                </div>
                <a href="https://www.duolingo.com/profile/Muhammad73304" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[#58cc02] hover:underline relative z-10">@Muhammad73304 →</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Certificates -->
    <div class="mb-8">
      <h2 class="text-h2 text-foreground mb-6 md:mb-8 flex flex-col items-start gap-3">
        <span class="flex items-center gap-3">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-primary shadow-[0_0_12px_rgba(249,115,22,0.5)]"></span>
          {activity.certificates}
        </span>
        <span class="block h-0.5 w-16 rounded-full bg-gradient-to-r from-primary to-primary/0"></span>
      </h2>

      <!-- ═══════ Coursera Google PM Progress Tracker ═══════ -->
      <div class="liquid-glass-card coursera-tracker mb-6 md:mb-8 relative overflow-hidden" id="coursera-tracker">
        <!-- Decorative background accent -->
        <div class="coursera-tracker-bg-glow"></div>
        
        <div class="coursera-tracker-inner">
          <!-- Left: Certificate Preview -->
          <div class="coursera-preview" id="coursera-preview">
            <div class="coursera-preview-frame group cursor-pointer" id="coursera-preview-frame" role="button" aria-label="Expand certificate">
              <img
                id="coursera-img-viewer"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                src="/Coursera/1.png"
                alt="Certificate Preview"
              />
              <div class="absolute inset-0 z-10 flex items-center justify-center transition-colors group-hover:bg-primary/5 pointer-events-auto">
                <div class="bg-background/80 backdrop-blur-sm p-3 rounded-full opacity-0 group-hover:opacity-100 transition-all transform scale-90 group-hover:scale-100 text-primary shadow-lg border border-primary/20">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                </div>
              </div>
              <div class="coursera-preview-placeholder pointer-events-none" id="coursera-preview-placeholder">
                <div class="coursera-preview-placeholder-icon">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                  </svg>
                </div>
                <p class="coursera-preview-placeholder-text">{activity.courseraProgressLocked}</p>
              </div>
            </div>
            <a href="https://coursera.org/share/e8cde4d71770bfaa10331a1207dfaf72" target="_blank" rel="noopener noreferrer" class="coursera-verify-link" id="coursera-verify-link">
              {activity.courseraViewCert}
            </a>
          </div>

          <!-- Right: Info + Progress -->
          <div class="coursera-info">
            <!-- Header -->
            <div class="coursera-info-header">
              <div class="coursera-google-logo" aria-hidden="true">
                <svg viewBox="0 0 272 92" width="80" height="28">
                  <path fill="#4285F4" d="M115.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18C71.25 34.32 81.24 25 93.5 25s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44S80.99 39.2 80.99 47.18c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z"/>
                  <path fill="#EA4335" d="M163.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18c0-12.85 9.99-22.18 22.25-22.18s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44s-12.51 5.46-12.51 13.44c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z"/>
                  <path fill="#FBBC05" d="M209.75 26.34v39.82c0 16.38-9.66 23.07-21.08 23.07-10.75 0-17.22-7.19-19.66-13.07l8.48-3.53c1.51 3.61 5.21 7.87 11.17 7.87 7.31 0 11.84-4.51 11.84-13v-3.19h-.34c-2.18 2.69-6.38 5.04-11.68 5.04-11.09 0-21.25-9.66-21.25-22.09 0-12.52 10.16-22.26 21.25-22.26 5.29 0 9.49 2.35 11.68 4.96h.34v-3.61h9.25zm-8.56 20.92c0-7.81-5.21-13.52-11.84-13.52-6.72 0-12.35 5.71-12.35 13.52 0 7.73 5.63 13.36 12.35 13.36 6.63 0 11.84-5.63 11.84-13.36z"/>
                  <path fill="#4285F4" d="M225 3v65h-9.5V3h9.5z"/>
                  <path fill="#34A853" d="M262.02 54.48l7.56 5.04c-2.44 3.61-8.32 9.83-18.48 9.83-12.6 0-22.01-9.74-22.01-22.18 0-13.19 9.49-22.18 20.92-22.18 11.51 0 17.14 9.16 18.98 14.11l1.01 2.52-29.65 12.28c2.27 4.45 5.8 6.72 10.75 6.72 4.96 0 8.4-2.44 10.92-6.14zm-23.27-7.98l19.82-8.23c-1.09-2.77-4.37-4.7-8.23-4.7-4.95 0-11.84 4.37-11.59 12.93z"/>
                  <path fill="#EA4335" d="M35.29 41.19V32H67c.31 1.64.47 3.58.47 5.68 0 7.06-1.93 15.79-8.15 22.01-6.05 6.3-13.78 9.66-24.02 9.66C16.32 69.35.36 53.89.36 34.91.36 15.93 16.32.47 35.3.47c10.5 0 17.98 4.12 23.6 9.49l-6.64 6.64c-4.03-3.78-9.49-6.72-16.97-6.72-13.86 0-24.7 11.17-24.7 25.03 0 13.86 10.84 25.03 24.7 25.03 8.99 0 14.11-3.61 17.39-6.89 2.66-2.66 4.41-6.46 5.1-11.65l-22.49-.21z"/>
                </svg>
              </div>
              <div>
                <h3 class="coursera-info-title">{activity.courseraProgressTitle}</h3>
                <p class="coursera-info-subtitle">{activity.courseraProgressSubtitle}</p>
              </div>
            </div>

            <!-- Progress counter -->
            <div class="coursera-progress-counter">
              <span class="coursera-progress-number">2</span>
              <span class="coursera-progress-label">{activity.courseraProgressOf} 7 {activity.courseraProgressCourses}</span>
            </div>

            <!-- Progress bar -->
            <div class="coursera-progress-bar-wrap">
              <div class="coursera-progress-bar">
                <div class="coursera-progress-bar-fill" style="width: 28.57%"></div>
              </div>
            </div>

            <!-- Step circles timeline -->
            <div class="coursera-timeline" id="coursera-timeline">
              <div class="coursera-timeline-track">
                <div class="coursera-timeline-track-fill"></div>
              </div>
              
              <button class="coursera-step is-completed is-active" data-step="1" data-img="/Coursera/1.png" data-link="https://coursera.org/share/e8cde4d71770bfaa10331a1207dfaf72" aria-label={activity.courseraCourse1} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="coursera-step-label">1</span>
              </button>

              <button class="coursera-step is-completed" data-step="2" data-img="/Coursera/2.png" data-link="https://coursera.org/share/1746690ca69abe39d7d5b812a6fc6597" aria-label={activity.courseraCourse2} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="coursera-step-label">2</span>
              </button>

              <button class="coursera-step is-locked" data-step="3" data-img="" data-link="" aria-label={activity.courseraCourse3} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="coursera-step-label">3</span>
              </button>

              <button class="coursera-step is-locked" data-step="4" data-img="" data-link="" aria-label={activity.courseraCourse4} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="coursera-step-label">4</span>
              </button>

              <button class="coursera-step is-locked" data-step="5" data-img="" data-link="" aria-label={activity.courseraCourse5} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="coursera-step-label">5</span>
              </button>

              <button class="coursera-step is-locked" data-step="6" data-img="" data-link="" aria-label={activity.courseraCourse6} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="coursera-step-label">6</span>
              </button>

              <button class="coursera-step is-locked" data-step="7" data-img="" data-link="" aria-label={activity.courseraCourse7} type="button">
                <span class="coursera-step-dot">
                  <svg class="coursera-step-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="coursera-step-label">7</span>
              </button>
            </div>

            <!-- Course name display -->
