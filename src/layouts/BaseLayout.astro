---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/utils';
import { pageMeta, pagePath, structuredData, type PageKey } from '../data/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import ParticlesBackground from '../components/ParticlesBackground.astro';
import MicrosoftClarity from '../components/MicrosoftClarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

import '../styles/global.css';

interface Props {
  locale: Locale;
  page?: PageKey;
}

const { locale, page = 'home' } = Astro.props;
const tr = t(locale);
const htmlLang = locale === 'ru' ? 'ru' : 'en';
const alternateLang = locale === 'ru' ? 'en' : 'ru';
const alternateUrl = pagePath(page, alternateLang);
const canonicalUrl = new URL(pagePath(page, locale), Astro.site);
const alternateFullUrl = new URL(alternateUrl, Astro.site);
const meta = pageMeta[locale][page];
const imageUrl = new URL('/images/avatar.jpg', Astro.site).href;
const jsonLd = JSON.stringify(structuredData(Astro.site!, locale, page)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Analytics (production only) -->
    <GoogleAnalytics />
    <MicrosoftClarity />

    <!-- Theme detection: runs before first paint to prevent FOUC -->
    <script is:inline>
      (function() {
        var d = document.documentElement;
        d.classList.add('no-transition');
        var stored = localStorage.getItem('theme');
        var theme = stored || 'light';
        d.setAttribute('data-theme', theme);
        d.style.colorScheme = theme;
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            d.classList.remove('no-transition');
          });
        });
      })();
    </script>

    <!-- SEO -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={tr.hero.fullName} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- i18n alternates -->
    <link rel="alternate" hreflang={htmlLang} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={alternateLang} href={alternateFullUrl.href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, 'en'), Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={tr.hero.fullName} />
    <meta property="og:site_name" content="Magomedov" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={tr.hero.fullName} />
    <meta name="twitter:site" content="@MMagomedovR" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <!-- Fonts: Google Fonts (Golos Text + Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme color -->
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
  </head>
  <body class="relative">
    <ParticlesBackground />
    <Header locale={locale} />

    <main>
      <slot />
    </main>

    <Footer locale={locale} />
    <Toast />
  </body>
</html>
