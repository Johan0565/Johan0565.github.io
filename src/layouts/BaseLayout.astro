---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/utils';
import { pageMeta, pagePath, structuredData, type PageKey } from '../data/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import ParticlesBackground from '../components/ParticlesBackground.astro';
import MicrosoftClarity from '../components/MicrosoftClarity.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

import '../styles/global.css';

interface Props {
  locale: Locale;
  page?: PageKey;
}

const { locale, page = 'home' } = Astro.props;
const tr = t(locale);
const htmlLang = locale === 'ru' ? 'ru' : 'en';
const alternateLang = locale === 'ru' ? 'en' : 'ru';
const alternateUrl = pagePath(page, alternateLang);
const canonicalUrl = new URL(pagePath(page, locale), Astro.site);
const alternateFullUrl = new URL(alternateUrl, Astro.site);
const meta = pageMeta[locale][page];
const imageUrl = new URL('/images/avatar.jpg', Astro.site).href;
const jsonLd = JSON.stringify(structuredData(Astro.site!, locale, page)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Analytics (production only) -->
    <GoogleAnalytics />
    <MicrosoftClarity />

    <!-- Theme detection: runs before first paint to prevent FOUC -->
    <script is:inline>
      (function() {
        var d = document.documentElement;
        d.classList.add('no-transition');
        var stored;
        try { stored = localStorage.getItem('theme'); } catch {}
        var systemTheme = typeof window.matchMedia === 'function' ? window.matchMedia('(prefers-color-scheme: light)') : null;
        var preference = stored === 'dark' || stored === 'light' ? stored : 'system';
        function applyTheme() {
          var choice = d.getAttribute('data-theme-preference');
          var theme = choice === 'dark' || choice === 'light' ? choice : (systemTheme && systemTheme.matches ? 'light' : 'dark');
          d.setAttribute('data-theme', theme);
          d.style.colorScheme = theme;
        }
        d.setAttribute('data-theme-preference', preference);
        applyTheme();
        if (systemTheme) {
          if (systemTheme.addEventListener) systemTheme.addEventListener('change', applyTheme);
          else if (systemTheme.addListener) systemTheme.addListener(applyTheme);
        }
        window.addEventListener('storage', function(event) {
          if (event.key !== 'theme' && event.key !== null) return;
          var choice = event.newValue;
          d.setAttribute('data-theme-preference', choice === 'dark' || choice === 'light' ? choice : 'system');
          applyTheme();
        });
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            d.classList.remove('no-transition');
          });
        });
      })();
    </script>

    {page === 'home' && <script is:inline>
      (function() {
        // Explicit localized URLs remain shareable; negotiate only the entry URL.
        if (location.pathname !== '/') return;
        var preferred;
        try { preferred = localStorage.getItem('locale'); } catch {}
        var language = preferred || ((navigator.languages && navigator.languages[0]) || navigator.language || 'en');
        if (language.toLowerCase().startsWith('ru')) location.replace('/ru/' + location.search + location.hash);
      })();
    </script>}

    <!-- SEO -->
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={tr.hero.fullName} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- i18n alternates -->
    <link rel="alternate" hreflang={htmlLang} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={alternateLang} href={alternateFullUrl.href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, 'en'), Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={tr.hero.fullName} />
    <meta property="og:site_name" content={tr.hero.fullName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={tr.hero.fullName} />
    <meta name="twitter:site" content="@MMagomedovR" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <!-- Two typefaces per page: display + body. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={page === 'home'
        ? 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap'
        : 'https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap'}
      rel="stylesheet"
    />

    <!-- Theme color -->
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
  </head>
  <body class="relative">
    {page !== 'home' && <ParticlesBackground />}
    {page !== 'home' && <Header locale={locale} />}

    <main>
      <slot />
    </main>

    {page !== 'home' && <Footer locale={locale} />}
    <Toast />
  </body>
</html>
